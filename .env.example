# ── Server ──────────────────────────────────────────────────────
# Bind address inside the container.
OLLAMA_HOST=0.0.0.0:11434
# Where model weights are written. Must stay inside the mounted volume.
OLLAMA_MODELS=/root/.ollama/models

# ── Performance / memory ────────────────────────────────────────
# How long a model stays resident after a request (e.g. 5m, 24h, -1 for always).
# Longer keeps latency down but holds RAM.
# OLLAMA_KEEP_ALIVE=5m

# How many models may be loaded at once. Each holds its full weight in RAM.
# OLLAMA_MAX_LOADED_MODELS=1

# Parallel request slots per model.
# OLLAMA_NUM_PARALLEL=1

# ── Local only ──────────────────────────────────────────────────
# Host port to publish (bound to 127.0.0.1 in docker-compose.yml).
# OLLAMA_PORT=11434

# ── Note on model size ──────────────────────────────────────────
# Inference here is CPU-bound. A model needs roughly its file size in RAM,
# so start small — llama3.2:1b is a sensible first pull.
